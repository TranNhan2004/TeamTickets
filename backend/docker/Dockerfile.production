# ======================
# Stage 1: Build
# ======================
FROM golang:1.23-alpine AS build

WORKDIR /src

RUN apk add --no-cache \
    git \
    ca-certificates

COPY go.mod go.sum ./

RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY . .

RUN --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 \
    GOOS=linux \
    go build \
    -trimpath \
    -ldflags="-s -w" \
    -o /out/team-tickets-api \
    ./cmd/api


# ======================
# Stage 2: Runtime
# ======================
FROM alpine:3.20 AS runtime

WORKDIR /app

RUN apk add --no-cache \
    ca-certificates \
    tzdata \
    && addgroup -S app \
    && adduser -S app -G app

COPY --from=build \
    --chown=app:app \
    /out/team-tickets-api \
    /app/team-tickets-api

USER app

EXPOSE 8000

ENTRYPOINT ["/app/team-tickets-api"]